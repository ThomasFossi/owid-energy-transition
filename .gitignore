# Virtual Environment
venv/
ENV/
env/
.venv/

# Data Files (Keeping raw local data out of version control, but tracking processed outputs)
data/raw/
data/processed/*.csv
data/processed/*.parquet
data/processed/*.xlsx

# Documentation Build / Output Artifacts (Keeping source markdown/PDFs tracked, ignoring build outputs)
docs/_build/
docs/*.pdf
docs/*.md

# Python / Jupyter Caches
__pycache__/
.ipynb_checkpoints/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# IDE / Editor Files (VS Code, PyCharm)
.vscode/
.idea/
*.swp
*.swo

# OS Files
.DS_Store
Thumbs.db

# Build / Distribution Artifacts
dist/
build/
*.egg-info/